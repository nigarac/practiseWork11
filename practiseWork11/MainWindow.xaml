<Window x:Class="practiseWork11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:practiseWork11"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox
            Margin="32,37,564,348"
            x:Name="FIO"
            Text="Фамилия Имя Отчество"/>
        <Button
            Margin="32,124,564,261"
            Content="Добавить"
            Click="addClick"/>
        <ListBox
            Margin="32,217,564,30"
            x:Name="listBox"/>
        <TextBox
            Margin="285,37,311,348"
            x:Name="razdelitel"/>
        <ComboBox
            Margin="285,124,311,261"
            x:Name="comboBox"/>
        <CheckBox
            Margin="285,217,311,168"
            x:Name="sortOnFIO"/>
        <CheckBox
            Margin="285,295,311,90"
            x:Name="reverse"/>
        <Button
            x:Name="printList"
            Margin="285,344,311,41"
            Content="Вывести список"/>
        <TextBlock
            Margin="564,37,32,348"
            x:Name="printResult"/>
        <Button
            x:Name="clearList"
            Margin="285,344,311,41"
            Content="Очистить список" Click="clearList_Click"/>
    </Grid>
</Window>
